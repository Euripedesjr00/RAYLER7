<UserControl x:Class="Rayler7.App.Views.Stage1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="Scroller">
        <StackPanel MaxWidth="1360" Margin="24,28">
            <!-- Título -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmAndAdvanceCommand}"
                        IsEnabled="{Binding CanAdvance}" VerticalAlignment="Top" Visibility="{Binding HasTemplate, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="CONFIRMAR MODELO E AVANÇAR  →" />
                </Button>
                <StackPanel>
                    <TextBlock Text="Etapa 1 de 3" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="ETAPA 1 – MODELO E CONFIGURAÇÃO DA PLANILHA" Style="{StaticResource H1}" FontSize="26" Margin="0,6,0,6" />
                    <TextBlock Style="{StaticResource Body}" MaxWidth="820" HorizontalAlignment="Left"
                               Text="Envie a planilha oficial que servirá de estrutura para o projeto. Nenhuma coluna, cabeçalho, fórmula ou dado preexistente será alterado sem sua autorização expressa." />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource ErrorBox}" Margin="0,16,0,0" x:Name="ErrorPanel" Visibility="Collapsed">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" />
            </Border>

            <!-- Arquivo da planilha-modelo -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="Projeto:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Width="240" Padding="8,6" FontSize="13" />
                            <Button Content="Salvar nome" Style="{StaticResource SmallOutlineButton}" Command="{Binding SaveNameCommand}" Margin="8,0,12,0" />
                            <Button Style="{StaticResource DarkButton}" Command="{Binding SelectTemplateCommand}" Padding="16,9">
                                <TextBlock Text="⤒  Selecionar planilha-modelo" />
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Arquivo da planilha-modelo" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                       Text="Modelo em Excel (.xlsx, .xlsm), CSV, TSV ou TXT delimitado. Se o modelo estiver em .xls ou .ods, abra no Excel ou LibreOffice e salve como .xlsx antes de enviar." />
                        </StackPanel>
                    </DockPanel>

                    <!-- Área de soltar (antes de enviar) -->
                    <Border Margin="0,18,0,0" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1.5" CornerRadius="12" Padding="40"
                            Background="{StaticResource SubtleBg}" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
                            Visibility="{Binding HasNoTemplate, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="▦" FontSize="34" Foreground="{StaticResource TextDisabled}" HorizontalAlignment="Center" />
                            <TextBlock Text="Arraste sua planilha-modelo aqui ou clique em “Selecionar planilha-modelo”" FontWeight="Medium"
                                       Foreground="{StaticResource Slate700Brush}" HorizontalAlignment="Center" Margin="0,8,0,4" />
                            <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                       Text="O sistema identificará linhas, colunas, cabeçalhos, células mescladas, fórmulas e abas. O arquivo original nunca é alterado." />
                        </StackPanel>
                    </Border>

                    <!-- Análise -->
                    <StackPanel Visibility="{Binding HasTemplate, Converter={StaticResource BoolToVis}}" Margin="0,18,0,0">
                        <Border Background="{StaticResource SubtleBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <UniformGrid Columns="6">
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Arquivo oficial" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding FileName}" Style="{StaticResource StatValue}" ToolTip="{Binding FileName}" /></StackPanel>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Abas" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding SheetsText}" Style="{StaticResource StatValue}" /></StackPanel>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Colunas" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding ColumnsText}" Style="{StaticResource StatValue}" /></StackPanel>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Linhas de dados" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding RowsText}" Style="{StaticResource StatValue}" /></StackPanel>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Preenchidas / Vazias" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding FilledText}" Style="{StaticResource StatValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Mesclagens / Fórmulas" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding MergesText}" Style="{StaticResource StatValue}" FontSize="13" /></StackPanel>
                            </UniformGrid>
                        </Border>

                        <Border Style="{StaticResource OkBox}" Margin="0,12,0,0" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="🔒 Estrutura protegida" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                                <ItemsControl ItemsSource="{Binding Notes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" Foreground="{StaticResource PrimaryText}" Margin="0,3,0,0" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Sheets}" Margin="0,12,0,0" Visibility="{Binding HasMultipleSheets, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Style="{StaticResource SmallOutlineButton}" Margin="0,0,6,6"
                                            Command="{Binding DataContext.SelectSheetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DataGrid ItemsSource="{Binding Preview}" AutoGenerateColumns="True" AutoGeneratingColumn="OnAutoColumn" IsReadOnly="True"
                                  Height="340" Margin="0,12,0,0" CanUserSortColumns="False" HeadersVisibility="Column" />
                        <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Instruções -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="{Binding HasTemplate, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="INSTRUÇÕES PARA ORGANIZAÇÃO E INTERPRETAÇÃO DOS DADOS" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                               Text="Campo opcional. Escreva como cada coluna, variável ou código deve ser interpretado. O RAYLER7 reconhece frases como “Coluna A corresponde ao tratamento” ou “Na primeira coluna, 1 significa carro”. O que não for entendido aparece para você conferir — nada é adivinhado." />
                    <TextBox Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                             VerticalScrollBarVisibility="Auto" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource DarkButton}" Command="{Binding InterpretInstructionsCommand}">
                            <TextBlock Text="Salvar e interpretar instruções" />
                        </Button>
                    </StackPanel>

                    <Border Style="{StaticResource OkBox}" Margin="0,14,0,0" Visibility="{Binding HasRules, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Regras de preservação reconhecidas (já garantidas pelo programa):" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" FontSize="13" />
                            <ItemsControl ItemsSource="{Binding RecognizedRules}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=✔ {0}}" Foreground="{StaticResource PrimaryText}" FontSize="12" Margin="0,3,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource WarnBox}" Margin="0,10,0,0" Visibility="{Binding HasUnrecognized, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Frases não interpretadas automaticamente — configure-as no mapeamento abaixo, se necessário:" FontWeight="SemiBold" Foreground="{StaticResource WarnText}" FontSize="13" />
                            <ItemsControl ItemsSource="{Binding Unrecognized}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Foreground="{StaticResource WarnText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ErrorBox}" Margin="0,10,0,0" Visibility="{Binding HasAmbiguities, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Ambiguidades — esclareça antes de continuar:" FontWeight="SemiBold" Foreground="{StaticResource ErrorText}" FontSize="13" />
                            <ItemsControl ItemsSource="{Binding Ambiguities}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Foreground="{StaticResource ErrorText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Mapeamento -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="{Binding HasTemplate, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Editar mapeamento" Style="{StaticResource SmallOutlineButton}" Command="{Binding UnlockMappingCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsMappingConfirmed, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmMappingCommand}">
                                <TextBlock Text="CONFIRMAR MAPEAMENTO" />
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Mapeamento das colunas" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                       Text="Confira a informação esperada em cada coluna. Códigos no formato “1 = carro; 2 = moto”. Depois de confirmado, o mapeamento fica travado." />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding MappingRows}" AutoGenerateColumns="False" Margin="0,14,0,0" MaxHeight="420"
                              IsReadOnly="{Binding IsMappingConfirmed}" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Coluna" Binding="{Binding Letter}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="Cabeçalho no modelo" Binding="{Binding Header}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="Informação esperada" Binding="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" Width="3*" />
                            <DataGridCheckBoxColumn Header="Numérica" Binding="{Binding ExpectNumeric, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridTextColumn Header="Códigos" Binding="{Binding DictionaryText, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridTextColumn Header="Origem" Binding="{Binding SourceLabel}" IsReadOnly="True" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Style="{StaticResource OkBox}" Margin="0,12,0,0" Visibility="{Binding IsMappingConfirmed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="✔ Mapeamento confirmado e salvo no projeto." Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmAndAdvanceCommand}" IsEnabled="{Binding CanAdvance}"
                    HorizontalAlignment="Right" Margin="0,20,0,0" Padding="22,12" Visibility="{Binding HasTemplate, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="CONFIRMAR MODELO E AVANÇAR PARA A ETAPA 2  →" />
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
