<UserControl x:Class="Rayler7.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Rayler7.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="460" Margin="0,48" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <c:BrazilFlag Width="56" Height="39" />
                    <c:IsraelFlag Width="56" Height="39" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="RAYLER7" Style="{StaticResource H1}" FontSize="34" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="Criado por Jhon" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}" Margin="0,4,0,0" />
                <TextBlock Text="“Desisti nunca foi uma opção!”" HorizontalAlignment="Center" Style="{StaticResource Muted}" FontStyle="Italic" Margin="0,2,0,24" />

                <!-- Primeira execução: criação do administrador -->
                <StackPanel x:Name="SetupPanel">
                    <Border Style="{StaticResource OkBox}" Margin="0,0,0,18">
                        <TextBlock Style="{StaticResource Body}" FontSize="13"
                                   Text="Primeira execução: crie a conta de administrador. Ela fica só neste computador, sem conta em nuvem." />
                    </Border>
                    <TextBlock Text="Nome de usuário" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
                    <TextBlock Text="Nome completo" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
                    <TextBlock Text="Senha (mínimo 8 caracteres, com letras e números)" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="SetupPassword" Margin="0,0,0,14" />
                    <TextBlock Text="Confirmar senha" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="SetupConfirm" Margin="0,0,0,20" />
                    <Button Content="CRIAR ADMINISTRADOR E ENTRAR" Style="{StaticResource PrimaryButton}" Click="OnCreateAdmin" x:Name="SetupButton" />
                </StackPanel>

                <!-- Login normal -->
                <StackPanel x:Name="LoginPanel">
                    <TextBlock Text="Nome de usuário ou e-mail" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
                    <TextBlock Text="Senha" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="0,0,0,8">
                        <PasswordBox x:Name="LoginPassword" />
                        <TextBox x:Name="LoginPasswordVisible" Visibility="Collapsed" />
                    </Grid>
                    <CheckBox x:Name="ShowPassword" Content="Mostrar senha" Checked="OnShowPassword" Unchecked="OnShowPassword"
                              Foreground="{StaticResource TextBody}" Margin="0,0,0,20" />
                    <Button Content="ENTRAR" Style="{StaticResource PrimaryButton}" Click="OnLogin" x:Name="LoginButton" />
                </StackPanel>

                <Border Style="{StaticResource ErrorBox}" Margin="0,16,0,0" Visibility="Collapsed" x:Name="ErrorBox">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" FontSize="13" />
                </Border>
                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,18,0,0"
                           Text="Recuperação de acesso pelo administrador: em desenvolvimento. Por segurança, não existe senha universal." />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
