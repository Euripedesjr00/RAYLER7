<UserControl x:Class="Rayler7.App.Views.PendingStageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="1200" Margin="24,32">
        <TextBlock Text="{Binding Eyebrow}" Style="{StaticResource Eyebrow}" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="26" Margin="0,6,0,16" />
        <Border Style="{StaticResource WarnBox}" Padding="18">
            <StackPanel>
                <TextBlock Text="PENDENTE — em desenvolvimento" FontWeight="Bold" Foreground="{StaticResource WarnText}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Foreground="{StaticResource WarnText}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
