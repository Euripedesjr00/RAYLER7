<UserControl x:Class="Rayler7.App.Views.Stage2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1360" Margin="24,28">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding BackToStage1Command}" VerticalAlignment="Top">
                    <TextBlock Text="←  Voltar para Etapa 1" />
                </Button>
                <StackPanel>
                    <TextBlock Text="Etapa 2 de 3" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="ETAPA 2 – ENVIO E EXTRAÇÃO DOS DADOS" Style="{StaticResource H1}" FontSize="26" Margin="0,6" />
                    <TextBlock Style="{StaticResource Body}" MaxWidth="860" HorizontalAlignment="Left"
                               Text="Envie planilhas, PDFs, documentos Word, CSV ou TXT. Os dados são lidos exatamente como estão nos arquivos, seguindo a ordem das colunas da planilha-modelo." />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource ErrorBox}" Margin="0,16,0,0" x:Name="ErrorPanel" Visibility="Collapsed">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" />
            </Border>

            <!-- Arquivos -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource DarkButton}" Command="{Binding AddFilesCommand}" Margin="0,0,8,0">
                                <TextBlock Text="＋  Selecionar / adicionar arquivos" />
                            </Button>
                            <Button Content="Remover todos os arquivos" Style="{StaticResource DangerLinkButton}" Command="{Binding RemoveAllCommand}"
                                    Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Arquivos de origem dos dados" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="Implementado: Excel (.xlsx, .xlsm), CSV, TSV, TXT, Word (.docx) e PDF com texto digital. Fotos e PDFs digitalizados são aceitos e guardados, mas o OCR entra na próxima versão." />
                        </StackPanel>
                    </DockPanel>

                    <Border Margin="0,16,0,0" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1.5" CornerRadius="12" Padding="28"
                            Background="{StaticResource SubtleBg}" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Arraste e solte quantos arquivos desejar aqui" FontWeight="Medium" Foreground="{StaticResource Slate700Brush}" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Text="Processamento em fila, um arquivo por vez, salvando o progresso a cada arquivo." />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Remover" Style="{StaticResource SmallOutlineButton}"
                                                Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontWeight="SemiBold" FontSize="12" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryText}" />
                                        <Border DockPanel.Dock="Left" Background="{StaticResource Subtle}" CornerRadius="6" Width="54" Padding="0,6" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource Slate700Brush}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Processamento -->
                    <Border Style="{StaticResource SubtleCard}" Padding="16" Margin="0,14,0,0" Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Interromper fila" Style="{StaticResource SmallOutlineButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartExtractionCommand}">
                                        <TextBlock Text="▶  Iniciar extração em lote" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding ProcessingText}" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="6" Margin="0,12,0,12" Foreground="{StaticResource Primary}" Background="{StaticResource Border}" BorderThickness="0" />
                            <UniformGrid Columns="6">
                                <StackPanel><TextBlock Text="Enviados" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Files.Count}" Style="{StaticResource StatValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Na fila" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Queued}" Style="{StaticResource StatValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Processados" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Done}" Style="{StaticResource StatValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Pendentes (OCR)" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding PendingFiles}" Style="{StaticResource StatValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Com falha" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Failed}" Style="{StaticResource StatValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Dados extraídos" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Summary.TotalExtracted}" Style="{StaticResource StatValue}" /></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Revisão e seleção -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="{Binding HasRecords, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Revisão dos dados extraídos" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12" Text="Cada dado mostra sua origem (arquivo, página, linha e coluna). O valor original nunca é alterado; correções ficam registradas no histórico." />

                    <Border Background="{StaticResource SubtleBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <UniformGrid Columns="6">
                            <StackPanel><TextBlock Text="Dados extraídos" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Summary.TotalExtracted}" Style="{StaticResource StatValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="Dados selecionados" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Summary.Selected}" Style="{StaticResource StatValue}" Foreground="{StaticResource PrimaryText}" /></StackPanel>
                            <StackPanel><TextBlock Text="Não selecionados" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Summary.NotSelected}" Style="{StaticResource StatValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="Pendentes de revisão" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Summary.PendingReview}" Style="{StaticResource StatValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="Com dúvida" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Summary.Doubtful}" Style="{StaticResource StatValue}" Foreground="{StaticResource WarnText}" /></StackPanel>
                            <StackPanel><TextBlock Text="Rejeitados" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Summary.Rejected}" Style="{StaticResource StatValue}" /></StackPanel>
                        </UniformGrid>
                    </Border>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleSelectAllCommand}" Margin="0,0,10,8" Padding="18,10"
                                ToolTip="Atua sobre TODOS os registros do processamento, em todas as páginas, mesmo os que não aparecem na tela.">
                            <TextBlock Text="{Binding SelectAllLabel}" />
                        </Button>
                        <Button Style="{StaticResource SoftButton}" Command="{Binding SelectFilteredCommand}" Margin="0,0,8,8"
                                Visibility="{Binding HasFilter, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectFilteredLabel}" />
                        </Button>
                        <Button Content="Desmarcar só os filtrados" Style="{StaticResource SmallOutlineButton}" Command="{Binding DeselectFilteredCommand}" Margin="0,0,16,8"
                                Visibility="{Binding HasFilter, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Filtro:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,8" />
                        <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="150" Margin="0,0,10,8" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="220" Margin="0,0,0,8" Padding="8,5" FontSize="13"
                                 ToolTip="Buscar por valor, arquivo ou campo" />
                    </WrapPanel>
                    <Border Style="{StaticResource WarnBox}" Margin="0,0,0,10" Visibility="{Binding HasFilter, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="12" Foreground="{StaticResource WarnText}" TextWrapping="Wrap"
                                   Text="Filtro ativo. O botão verde atua sobre TODOS os registros do processamento; o botão “Selecionar só os filtrados” atua apenas nos registros encontrados pelo filtro." />
                    </Border>

                    <DataGrid ItemsSource="{Binding PageRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" Height="420" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✔" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Arquivo" Binding="{Binding Record.SourceFile}" IsReadOnly="True" Width="1.4*" />
                            <DataGridTextColumn Header="Origem" Binding="{Binding Location}" IsReadOnly="True" Width="110" />
                            <DataGridTextColumn Header="Destino" Binding="{Binding Target}" IsReadOnly="True" Width="64" />
                            <DataGridTextColumn Header="Campo" Binding="{Binding Record.FieldName}" IsReadOnly="True" Width="1.2*" />
                            <DataGridTextColumn Header="Valor original" Binding="{Binding Original}" IsReadOnly="True" Width="1.1*" FontFamily="{StaticResource MonoFont}" />
                            <DataGridTextColumn Header="Valor a usar" Binding="{Binding ToUse}" IsReadOnly="True" Width="1.1*" FontFamily="{StaticResource MonoFont}" />
                            <DataGridTextColumn Header="Situação" Binding="{Binding StatusLabel}" IsReadOnly="True" Width="96" />
                            <DataGridTextColumn Header="Avisos" Binding="{Binding Warning}" IsReadOnly="True" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="← Anterior" Style="{StaticResource SmallOutlineButton}" Command="{Binding PrevPageCommand}" Margin="0,0,6,0" />
                            <Button Content="Próxima →" Style="{StaticResource SmallOutlineButton}" Command="{Binding NextPageCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PageText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Conferência de dúvidas -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="{Binding HasDoubts, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Conferência de Dúvidas" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                               Text="O sistema não decide sozinho quando há ambiguidade (0 × 8, 1 × 7, vírgula × ponto, coluna sem destino). Confirme, corrija, deixe vazio ou rejeite. Mostrando até 200 dúvidas abertas por vez." />
                    <ItemsControl ItemsSource="{Binding DoubtRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WarnBox}" Margin="0,0,0,10" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{StaticResource WarnText}" FontSize="12" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock Text="Valor identificado: " FontSize="13" Foreground="{StaticResource Slate700Brush}" />
                                            <TextBlock Text="{Binding Identified}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Text}" />
                                            <TextBlock Text="     Alternativa: " FontSize="13" Foreground="{StaticResource Slate700Brush}" Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Suggested}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Reasons}" Style="{StaticResource Muted}" Foreground="{StaticResource WarnText}" Margin="0,4,0,8" />
                                        <WrapPanel>
                                            <Button Content="Confirmar valor identificado" Style="{StaticResource SmallPrimaryButton}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.ConfirmDoubtCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Usar alternativa" Style="{StaticResource SmallOutlineButton}" Margin="0,0,6,6" Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" Width="140" Padding="6,4" FontSize="13" Margin="0,0,6,6" FontFamily="{StaticResource MonoFont}" />
                                            <Button Content="Salvar correção manual" Style="{StaticResource SmallOutlineButton}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.SaveCorrectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Deixar campo vazio" Style="{StaticResource SmallOutlineButton}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.LeaveEmptyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Rejeitar" Style="{StaticResource DangerLinkButton}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.RejectDoubtCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Conferência final -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="{Binding HasRecords, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Conferência final" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding ConferenceText}" Style="{StaticResource Body}" FontSize="13" Margin="0,8,0,0" />
                    <Border Style="{StaticResource WarnBox}" Margin="0,12,0,0" Visibility="{Binding NeedsAuthorization, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnText}" FontSize="13">
                                <Run Text="Atenção: " FontWeight="Bold" /><Run Text="{Binding SelectedOpenDoubts, Mode=OneWay}" FontWeight="Bold" /><Run Text=" dado(s) selecionado(s) ainda têm dúvida aberta. Eles ficam fora da planilha, a menos que você autorize explicitamente." />
                            </TextBlock>
                            <CheckBox IsChecked="{Binding AllowProceedWithPending}" Margin="0,8,0,0" Foreground="{StaticResource WarnText}"
                                      Content="Autorizo incluir os campos duvidosos, mantendo-os sinalizados no histórico" />
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmAndProceedCommand}" IsEnabled="{Binding CanProceed}" Padding="22,12">
                            <TextBlock Text="CONFIRMAR E PROSSEGUIR PARA A GERAÇÃO  →" />
                        </Button>
                        <TextBlock Text="✔ Nenhum número é arredondado, convertido ou calculado automaticamente." Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource OkBox}" Margin="0,14,0,0" Visibility="{Binding HasFilled, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Abrir pasta do arquivo" Style="{StaticResource SmallOutlineButton}" Command="{Binding OpenFilledFolderCommand}" />
                            <StackPanel>
                                <TextBlock Text="✔ Planilha preenchida gerada (cópia de trabalho; o modelo original continua intacto):" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                                <TextBlock Text="{Binding FilledPath}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource PrimaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
