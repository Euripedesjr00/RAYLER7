<UserControl x:Class="Rayler7.App.Views.Stage3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ex="clr-namespace:Rayler7.Infrastructure.Export;assembly=Rayler7.Infrastructure"
             xmlns:c="clr-namespace:Rayler7.App.Controls"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1360" Margin="24,28">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding AddMoreDataCommand}" VerticalAlignment="Top">
                    <TextBlock Text="←  REVISAR DADOS (Etapa 2)" />
                </Button>
                <StackPanel>
                    <TextBlock Text="Etapa 3 de 3" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="ETAPA 3 – PERSONALIZAÇÃO E FORMATAÇÃO" Style="{StaticResource H1}" FontSize="26" Margin="0,6" />
                    <TextBlock Style="{StaticResource Body}" MaxWidth="860" HorizontalAlignment="Left"
                               Text="Escolha a aparência antes de exportar. Nenhum dado numérico ou textual é alterado nesta etapa: o programa confere célula por célula antes de gravar." />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource ErrorBox}" Margin="0,16,0,0" x:Name="ErrorPanel" Visibility="Collapsed">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Modelos de aparência -->
                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Modelos de aparência e ajustes" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Style="{StaticResource SmallOutlineButton}" Margin="0,0,6,6"
                                            Command="{Binding DataContext.ApplyPresetCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource OkBox}" Margin="0,8,0,0" Visibility="{Binding IsOriginal, Converter={StaticResource BoolToVis}}">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource PrimaryText}"
                                       Text="A aparência da planilha-modelo será mantida exatamente como está." />
                        </Border>
                        <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <TextBlock Text="Cores (formato #RRGGBB)" Style="{StaticResource FieldLabel}" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,6,8"><TextBlock Text="Fundo do cabeçalho" Style="{StaticResource Muted}" /><TextBox Text="{Binding HeaderBackground, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="12" /></StackPanel>
                                <StackPanel Margin="0,0,0,8"><TextBlock Text="Texto do cabeçalho" Style="{StaticResource Muted}" /><TextBox Text="{Binding HeaderText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="12" /></StackPanel>
                                <StackPanel Margin="0,0,6,8"><TextBlock Text="Fundo alternado" Style="{StaticResource Muted}" /><TextBox Text="{Binding ZebraBackground, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="12" /></StackPanel>
                                <StackPanel Margin="0,0,0,8"><TextBlock Text="Bordas" Style="{StaticResource Muted}" /><TextBox Text="{Binding BorderColor, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="12" /></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel IsEnabled="{Binding IsOriginal, Converter={StaticResource InverseBool}}">
                            <TextBlock Text="Fonte" Style="{StaticResource FieldLabel}" Margin="0,8,0,6" />
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" Width="70" Margin="8,0,0,0" />
                                <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding FontName}" />
                            </DockPanel>
                            <CheckBox Content="Congelar cabeçalho no Excel" IsChecked="{Binding FreezeHeader}" Margin="0,10,0,0" />
                            <CheckBox Content="Ajustar largura das colunas automaticamente" IsChecked="{Binding AutoFit}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmFormattingCommand}" Margin="0,16,0,0">
                            <TextBlock Text="CONFIRMAR FORMATAÇÃO" />
                        </Button>
                        <Border Style="{StaticResource OkBox}" Margin="0,10,0,0" Visibility="{Binding FormattingConfirmed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="✔ Formatação visual confirmada" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Prévia -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock Text="Prévia visual" Style="{StaticResource H2}" />
                        </DockPanel>
                        <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding Preview}" AutoGenerateColumns="True" AutoGeneratingColumn="OnAutoColumn" IsReadOnly="True"
                                  HeadersVisibility="Column" Height="440" Margin="0,12,0,0" CanUserSortColumns="False"
                                  FontFamily="{Binding FontName}" FontSize="{Binding FontSize}"
                                  AlternatingRowBackground="{Binding ZebraBrush}" BorderBrush="{Binding BorderBrushColor}"
                                  HorizontalGridLinesBrush="{Binding BorderBrushColor}" VerticalGridLinesBrush="{Binding BorderBrushColor}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{Binding DataContext.HeaderBrush, ElementName=Root}" />
                                    <Setter Property="Foreground" Value="{Binding DataContext.HeaderTextBrush, ElementName=Root}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="BorderBrush" Value="{Binding DataContext.BorderBrushColor, ElementName=Root}" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="A prévia mostra até 60 linhas. Os valores são exatamente os da planilha preenchida." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Exportação -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <RadioButton Content="Todas as abas" IsChecked="{Binding AllSheets}" Margin="0,0,14,0" GroupName="scope" />
                            <RadioButton Content="Apenas a aba principal" GroupName="scope" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="EXPORTAR DADOS" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="820" HorizontalAlignment="Left"
                                       Text="Compatível com Excel, LibreOffice, R/RStudio, SPSS, Stata, SAS, Jamovi e JASP. Formatos estatísticos são entregues como pacote CSV UTF-8 + script de importação (tudo como texto, sem conversão silenciosa). Não geramos .sav, .dta ou .xls nativos: os pacotes abrem direto nesses programas." />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" CommandParameter="{x:Static ex:ExportFormat.Xlsx}" Margin="0,0,8,8"><TextBlock Text="⤓  BAIXAR EXCEL" /></Button>
                        <Button Style="{StaticResource DarkButton}" Command="{Binding ExportCommand}" CommandParameter="{x:Static ex:ExportFormat.Ods}" Margin="0,0,8,8"><TextBlock Text="⤓  BAIXAR ODS" /></Button>
                        <Button Style="{StaticResource DarkButton}" Command="{Binding ExportCommand}" CommandParameter="{x:Static ex:ExportFormat.CsvUtf8Semicolon}" Margin="0,0,8,8"><TextBlock Text="⤓  BAIXAR CSV" /></Button>
                        <Button Style="{StaticResource DarkButton}" Command="{Binding ExportCommand}" CommandParameter="{x:Static ex:ExportFormat.PackageSpss}" Margin="0,0,8,8"><TextBlock Text="⤓  BAIXAR SPSS" /></Button>
                        <Button Style="{StaticResource DarkButton}" Command="{Binding ExportCommand}" CommandParameter="{x:Static ex:ExportFormat.PackageStata}" Margin="0,0,8,8"><TextBlock Text="⤓  BAIXAR STATA" /></Button>
                        <Button Style="{StaticResource DarkButton}" Command="{Binding ExportCommand}" CommandParameter="{x:Static ex:ExportFormat.Dbf}" Margin="0,0,8,8"><TextBlock Text="⤓  BAIXAR DBF" /></Button>
                        <Button Style="{StaticResource OutlineButton}" Command="{Binding ToggleFormatsCommand}" Margin="0,0,8,8"><TextBlock Text="BAIXAR OUTROS FORMATOS" /></Button>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Formats}" Visibility="{Binding ShowAllFormats, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="GERAR ARQUIVO" Style="{StaticResource SmallOutlineButton}"
                                                Command="{Binding DataContext.ExportCommand, ElementName=Root}" CommandParameter="{Binding Format}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Mensagem final: só aparece depois que o arquivo foi efetivamente gravado -->
            <Border x:Name="FinalCard" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="32" Opacity="0"
                    Visibility="{Binding ExportCompleted, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <c:BrazilFlag Width="56" Height="39" VerticalAlignment="Center" />
                        <StackPanel Margin="20,0">
                            <TextBlock Text="Criado por Jhon" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock Text="Desisti nunca foi uma opção!" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryText}" />
                        </StackPanel>
                        <c:IsraelFlag Width="56" Height="39" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,14,0,0" MaxWidth="640"
                               Text="Exportação concluída preservando a estrutura oficial da planilha e todos os valores originais. O projeto continua salvo para você continuar depois." />
                    <TextBlock Text="{Binding LastExport}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource TextBody}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Content="Abrir pasta do arquivo" Style="{StaticResource SmallOutlineButton}" Command="{Binding OpenExportFolderCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SoftButton}" Command="{Binding AddMoreDataCommand}"><TextBlock Text="＋ ADICIONAR NOVOS DADOS AO PROJETO" /></Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
