<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Rayler7.App</RootNamespace>
    <AssemblyName>RAYLER7</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>pt-BR;pt</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\rayler7.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);MVVMTK0045;CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\rayler7.ico" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rayler7.Core\Rayler7.Core.csproj" />
    <ProjectReference Include="..\Rayler7.Infrastructure\Rayler7.Infrastructure.csproj" />
  </ItemGroup>
</Project>
