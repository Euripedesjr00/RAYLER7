<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta do layout de referência (slate + emerald) -->
    <Color x:Key="Slate50">#F8FAFC</Color>
    <Color x:Key="Slate100">#F1F5F9</Color>
    <Color x:Key="Slate200">#E2E8F0</Color>
    <Color x:Key="Slate300">#CBD5E1</Color>
    <Color x:Key="Slate400">#94A3B8</Color>
    <Color x:Key="Slate500">#64748B</Color>
    <Color x:Key="Slate600">#475569</Color>
    <Color x:Key="Slate700">#334155</Color>
    <Color x:Key="Slate800">#1E293B</Color>
    <Color x:Key="Slate900">#0F172A</Color>
    <Color x:Key="Emerald50">#ECFDF5</Color>
    <Color x:Key="Emerald200">#A7F3D0</Color>
    <Color x:Key="Emerald700">#047857</Color>
    <Color x:Key="Emerald800">#065F46</Color>
    <Color x:Key="Amber50">#FFFBEB</Color>
    <Color x:Key="Amber300">#FCD34D</Color>
    <Color x:Key="Amber800">#92400E</Color>
    <Color x:Key="Red50">#FEF2F2</Color>
    <Color x:Key="Red600">#DC2626</Color>
    <Color x:Key="Red700">#B91C1C</Color>

    <SolidColorBrush x:Key="Slate300Brush" Color="{StaticResource Slate300}" />
    <SolidColorBrush x:Key="Slate700Brush" Color="{StaticResource Slate700}" />
    <SolidColorBrush x:Key="Slate800Brush" Color="{StaticResource Slate800}" />
    <SolidColorBrush x:Key="PageBg" Color="{StaticResource Slate50}" />
    <SolidColorBrush x:Key="CardBg" Color="White" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource Slate200}" />
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource Slate300}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource Slate900}" />
    <SolidColorBrush x:Key="TextBody" Color="{StaticResource Slate600}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource Slate500}" />
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource Slate400}" />
    <SolidColorBrush x:Key="Subtle" Color="{StaticResource Slate100}" />
    <SolidColorBrush x:Key="SubtleBg" Color="{StaticResource Slate50}" />
    <SolidColorBrush x:Key="Primary" Color="{StaticResource Emerald700}" />
    <SolidColorBrush x:Key="PrimaryHover" Color="{StaticResource Emerald800}" />
    <SolidColorBrush x:Key="PrimarySoft" Color="{StaticResource Emerald50}" />
    <SolidColorBrush x:Key="PrimarySoftBorder" Color="{StaticResource Emerald200}" />
    <SolidColorBrush x:Key="PrimaryText" Color="{StaticResource Emerald800}" />
    <SolidColorBrush x:Key="Dark" Color="{StaticResource Slate900}" />
    <SolidColorBrush x:Key="DarkHover" Color="{StaticResource Slate800}" />
    <SolidColorBrush x:Key="WarnBg" Color="{StaticResource Amber50}" />
    <SolidColorBrush x:Key="WarnBorder" Color="{StaticResource Amber300}" />
    <SolidColorBrush x:Key="WarnText" Color="{StaticResource Amber800}" />
    <SolidColorBrush x:Key="ErrorBg" Color="{StaticResource Red50}" />
    <SolidColorBrush x:Key="ErrorText" Color="{StaticResource Red700}" />

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Tipografia -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Cartões -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="SubtleCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource SubtleBg}" />
    </Style>
    <Style x:Key="WarnBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarnBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarnBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="ErrorBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ErrorBg}" />
        <Setter Property="BorderBrush" Value="#FECACA" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="OkBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimarySoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimarySoftBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Botões -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#059669" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Subtle}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Border}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Dark}" />
        <Setter Property="BorderBrush" Value="{StaticResource Dark}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="Foreground" Value="{StaticResource Slate800Brush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SubtleBg}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource PrimarySoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimarySoftBorder}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="SmallPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="SmallOutlineButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="DangerLinkButton" TargetType="Button" BasedOn="{StaticResource SmallOutlineButton}">
        <Setter Property="Foreground" Value="{StaticResource ErrorText}" />
    </Style>

    <!-- Abas de navegação do cabeçalho -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="0,4" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Slate300Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campos -->
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Slate700Brush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SubtleBg}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Subtle}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Subtle}" />
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="ColumnHeaderHeight" Value="34" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Subtle}" />
        <Setter Property="Foreground" Value="{StaticResource Slate700Brush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
</ResourceDictionary>
